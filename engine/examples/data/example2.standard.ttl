@prefix ex:  <http://example.org/paper#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
ex:t1 rdf:subject ex:A ; rdf:predicate ex:p ; rdf:object ex:B .
ex:t2 rdf:subject ex:A ; rdf:predicate ex:p ; rdf:object ex:B .   # parallel edge (sharing)
ex:t3 rdf:subject ex:B ; rdf:predicate ex:q ; rdf:object ex:C .
ex:t4 rdf:subject ex:A ; rdf:predicate ex:p ; rdf:object ex:D .
ex:t5 rdf:subject ex:D ; rdf:predicate ex:q ; rdf:object ex:C .
ex:t6 rdf:subject ex:A ; rdf:predicate ex:r ; rdf:object ex:E .
ex:t7 rdf:subject ex:A ; rdf:predicate ex:p ; rdf:object ex:F .   # F has no q  (optional-unbound case)
