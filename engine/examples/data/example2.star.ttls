<< ex:D ex:q ex:C >> occ:occurrenceOf ex:t5 .
<< ex:A ex:r ex:E >> occ:occurrenceOf ex:t6 .
<< ex:A ex:p ex:F >> occ:occurrenceOf ex:t7 .
