PREFIX : <http://example.org/paper#>
# Out of the supported fragment: EXISTS carries a graph pattern, hence provenance, of its
# own, so it is not a condition the rewriting can render into an operand's group. BOTH
# rewriters MUST reject this rather than silently drop the FILTER.
# Used by reference/verify_gallery.py's rejection guard.
SELECT ?y WHERE { :Alice :knows ?y . FILTER EXISTS { ?y :city ?c } }
