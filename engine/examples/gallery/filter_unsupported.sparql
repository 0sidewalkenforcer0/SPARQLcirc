PREFIX : <http://example.org/paper#>
# Historical name: the NPCS string rewriter (npcs.rewrite) once had no filter rule and had to
# reject this query. It now carries the FILTER into the reified group, as the circuit rewriter
# (npcs.circuit, Def. 4.5, clause 6) does; reference/verify_gallery.py checks that the rewritten
# query keeps the condition. filter_exists_unsupported.sparql is a condition BOTH rewriters
# still reject.
SELECT ?y WHERE { :Alice :knows ?y . FILTER(?y != :Bob) }
